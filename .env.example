# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@theregencyws.co.uk

# Must match the FUNCTION_SECRET set via `supabase secrets set` — this is
# how the Next.js app authenticates its calls to the send-push Edge
# Function when an event is created/updated. Generate any random string.
FUNCTION_SECRET=

# Email (Resend)
RESEND_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=https://theregencyws.co.uk
